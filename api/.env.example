# Porta HTTP da API
PORT=3000
# Endereço do PostgreSQL (localhost fora do Docker; "db" dentro do compose)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=servicecontrol
DB_PASSWORD=servicecontrol
DB_DATABASE=servicecontrol
# true = sincroniza schema automaticamente (somente dev)
DB_SYNCHRONIZE=true
# Segredo de assinatura do JWT (troque fora de dev)
JWT_SECRET=servicecontrol-dev-secret
# Tempo de expiração do token
JWT_EXPIRES_IN=8h
# --- Seed inicial (empresa + usuário admin para testes) — OBRIGATÓRIAS ---
SEED_COMPANY_CNPJ=11222333000181
SEED_COMPANY_NAME=Empresa Seed
SEED_ADMIN_EMAIL=admin@servicecontrol.com.br
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Administrador